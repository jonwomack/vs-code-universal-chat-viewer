{
  "name": "cross-workspace-chat-viewer",
  "displayName": "Cross-Workspace Chat Viewer",
  "description": "Search local VS Code and GitHub Copilot CLI chats across workspaces.",
  "version": "0.4.21",
  "publisher": "jonwomack",
  "license": "MIT",
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonwomack/vs-code-universal-chat-viewer.git"
  },
  "homepage": "https://github.com/jonwomack/vs-code-universal-chat-viewer#readme",
  "bugs": {
    "url": "https://github.com/jonwomack/vs-code-universal-chat-viewer/issues"
  },
  "qna": "https://github.com/jonwomack/vs-code-universal-chat-viewer/discussions",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "chat",
    "copilot",
    "history",
    "search",
    "router",
    "workspace",
    "conversation"
  ],
  "activationEvents": [
    "onView:crossWorkspaceChatViewer.sessions",
    "onCommand:crossWorkspaceChatViewer.open",
    "onCommand:crossWorkspaceChatViewer.routePrompt",
    "onCommand:crossWorkspaceChatViewer.configureAzureEmbeddings",
    "onCommand:crossWorkspaceChatViewer.rebuildSemanticIndex",
    "onCommand:crossWorkspaceChatViewer.disableSemanticRouting",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crossWorkspaceChatViewer",
          "title": "Workspace Chats",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "crossWorkspaceChatViewer": [
        {
          "id": "crossWorkspaceChatViewer.sessions",
          "name": "Chats",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "crossWorkspaceChatViewer.open",
        "title": "Workspace Chats: Open Viewer",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "crossWorkspaceChatViewer.refresh",
        "title": "Workspace Chats: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "crossWorkspaceChatViewer.routePrompt",
        "title": "Workspace Chats: Route Prompt"
      },
      {
        "command": "crossWorkspaceChatViewer.configureAzureEmbeddings",
        "title": "Workspace Chats: Configure Azure Semantic Routing"
      },
      {
        "command": "crossWorkspaceChatViewer.rebuildSemanticIndex",
        "title": "Workspace Chats: Rebuild Semantic Index"
      },
      {
        "command": "crossWorkspaceChatViewer.disableSemanticRouting",
        "title": "Workspace Chats: Disable Semantic Routing and Remove Key"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "crossWorkspaceChatViewer.refresh",
          "when": "view == crossWorkspaceChatViewer.sessions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Cross-Workspace Chat Viewer",
      "properties": {
        "crossWorkspaceChatViewer.additionalStorageRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional workspaceStorage folders to scan."
        },
        "crossWorkspaceChatViewer.openWorkspaceInNewWindow": {
          "type": "boolean",
          "default": false,
          "description": "Open a chat's original workspace in a new window before continuing it."
        },
        "crossWorkspaceChatViewer.recoverMissingWorkspaces": {
          "type": "boolean",
          "default": true,
          "description": "Offer to create a recovered workspace from surviving folders referenced by a chat when its original workspace is missing."
        },
        "crossWorkspaceChatViewer.openNewWindowWhenChatActive": {
          "type": "boolean",
          "default": true,
          "description": "Open a destination workspace in a new window when replacing the current workspace could interrupt an active chat response."
        },
        "crossWorkspaceChatViewer.displayChatPreview": {
          "type": "boolean",
          "default": false,
          "description": "Display the selected chat transcript inside the extension before or while opening its native chat."
        },
        "crossWorkspaceChatViewer.autoOpenChatOnSelect": {
          "type": "boolean",
          "default": true,
          "description": "Immediately continue the native chat when it is selected in the extension list. Disable this and enable chat preview to use Continue chat manually."
        },
        "crossWorkspaceChatViewer.routePromptsAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the highest-ranked chat when routing a prompt instead of showing the ranked thread picker."
        },
        "crossWorkspaceChatViewer.semanticRouting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use a configured Azure OpenAI embedding deployment to rank chats semantically. Full transcript text is sent to that endpoint while the index is built."
        },
        "crossWorkspaceChatViewer.semanticRouting.azure.endpoint": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI resource endpoint, such as https://your-resource.openai.azure.com."
        },
        "crossWorkspaceChatViewer.semanticRouting.azure.deployment": {
          "type": "string",
          "default": "text-embedding-3-small",
          "description": "Azure OpenAI embedding deployment name."
        },
        "crossWorkspaceChatViewer.semanticRouting.dimensions": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1536,
          "default": 256,
          "description": "Embedding dimensions requested from text-embedding-3-small. Lower values reduce local index size."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
